# Copy this file to .env and fill in real values before running
# `docker-compose up`. .env is gitignored - never commit real secrets.

# --- Required ---

# Symmetric HS256 signing key shared by auth-service and gateway-service.
# Generate a fresh one, don't reuse this example:
#   openssl rand -base64 32
JWT_SECRET=

# --- Optional (sensible defaults are used if unset) ---

# Local Postgres superuser password. Fine to leave as the default for
# local development; use a real secret for anything beyond your own
# machine.
DB_PASSWORD=postgres

# Host-side port Postgres is reachable on (e.g. for psql from your own
# machine). Only matters if 5432 is already taken by something else on
# your host - very common if you have a native Postgres install or
# another Docker project already using it. Leave as 5432 unless you hit
# "address already in use" when running `docker compose up`, in which
# case set this to something else (e.g. 5433) and re-run - nothing else
# needs to change, every backend service reaches Postgres over the
# internal Docker network regardless of this value.
DB_HOST_PORT=5432

# Backend URL the frontend is built against. Only matters if you're
# building the frontend image for something other than local
# docker-compose (e.g. pointing a build at a staging Gateway).
GATEWAY_URL=http://localhost:8080

# Google Maps JavaScript API key, used by the location-picker on the
# victim/volunteer forms. Leave empty to run everything else normally -
# only the map widget itself won't load. Get a key at
# https://console.cloud.google.com/google/maps-apis and restrict it to
# your domain before using it anywhere but localhost.
GOOGLE_MAPS_API_KEY=
